CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
OBSIDIAN_API_KEY=

# Anthropic API (for AI alt text generation)
ANTHROPIC_API_KEY=

# Mastodon syndication (post to Mastodon after publishing)
MASTODON_INSTANCE=mastodon.social
MASTODON_ACCESS_TOKEN=

# Bluesky syndication (AT Protocol). Use an App Password, never your main password:
# bsky.app → Settings → Privacy and security → App passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Optional: your PDS if not on bsky.social
# BLUESKY_SERVICE=https://bsky.social

# Set to 1 to build every syndication payload (logged + shown in the wizard)
# without sending anything.
# DISPATCH_SYNDICATE_DRY_RUN=1

# Umami Analytics
UMAMI_URL=https://umami.tools.ejfox.com
UMAMI_USERNAME=
UMAMI_PASSWORD=
UMAMI_WEBSITE_ID=
